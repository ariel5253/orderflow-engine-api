# Name of the PostgreSQL database the service uses (spring.datasource.url)
DB_NAME=orderflow
# PostgreSQL user the service connects as (spring.datasource.username)
DB_USER=orderflow
# Password of that user (spring.datasource.password): set a real value only in your local .env
DB_PASSWORD=change-me
# HTTP port of the service (server.port), inside the container and on the host
API_PORT=8080
# Language of the error messages when Accept-Language is missing or unsupported (app.i18n.default-locale)
API_DEFAULT_LOCALE=es
