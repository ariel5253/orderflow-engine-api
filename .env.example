# Name of the PostgreSQL database the service uses (spring.datasource.url)
DB_NAME=orderflow
# PostgreSQL user the service connects as (spring.datasource.username)
DB_USER=orderflow
# Password of that user (spring.datasource.password): set a real value only in your local .env
DB_PASSWORD=change-me
# HTTP port of the service (server.port), inside the container and on the host
API_PORT=8080
# Language of the error messages when Accept-Language is missing or unsupported (app.i18n.default-locale)
API_DEFAULT_LOCALE=es
# Outbox relay
# How long the outbox relay waits between two polls for due events (app.outbox.poll-interval)
API_OUTBOX_POLL_INTERVAL=1s
# How long a claimed outbox event stays leased before it may be sent again (app.outbox.lease)
API_OUTBOX_LEASE=30s
# Delivery attempts before an outbox event becomes DEAD (app.outbox.max-attempts)
API_OUTBOX_MAX_ATTEMPTS=8
# Longest wait after the first failed delivery, doubled after each further one (app.outbox.backoff.base)
API_OUTBOX_BACKOFF_BASE=2s
# Longest wait between two delivery attempts (app.outbox.backoff.max)
API_OUTBOX_BACKOFF_MAX=5m
